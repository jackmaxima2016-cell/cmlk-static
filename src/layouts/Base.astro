---
// Layout de base — head SEO complet (title, description, canonical, og, JSON-LD)
import { decodeEntities } from '../lib/wp.mjs';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: object[];
  type?: 'website' | 'article';
  relPrev?: string;
  relNext?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = false,
  jsonLd = [],
  type = 'website',
  relPrev,
  relNext,
} = Astro.props;

const site = String(Astro.site ?? 'https://fluiid.ch').replace(/\/$/, '');
const pageUrl = canonical ?? site + '/';
const ogType = type === 'article' ? 'article' : 'website';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{decodeEntities(title)}</title>
    {description && <meta name="description" content={decodeEntities(description)} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={pageUrl} />
    {relPrev && <link rel="prev" href={relPrev} />}
    {relNext && <link rel="next" href={relNext} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Fluiid" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={decodeEntities(title)} />
    {description && <meta property="og:description" content={decodeEntities(description)} />}
    {ogImage && <meta property="og:image" content={ogImage} />}

    <link rel="sitemap" href={site + '/sitemap-index.xml'} />
    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href="/">Fluiid</a>
        <nav>
          <a href="/">Accueil</a>
          <a href="/contact/">Contact</a>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>Fluiid — L’actualité en Europe et dans le monde</p>
      </div>
    </footer>
  </body>
</html>
