---
// Layout de base — head SEO complet (title, description, canonical, og, JSON-LD)
// Header magazine : bandeau date + marque + navigation rubriques sticky
import { decodeEntities, getCategories } from '../lib/wp.mjs';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: object[];
  type?: 'website' | 'article';
  relPrev?: string;
  relNext?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = false,
  jsonLd = [],
  type = 'website',
  relPrev,
  relNext,
} = Astro.props;

// Préversion : NOINDEX=1 au build => toutes les pages en noindex
const noindexAll = typeof process !== 'undefined' && process.env.NOINDEX === '1';

const site = String(Astro.site ?? 'https://fluiid.ch').replace(/\/$/, '');
const pageUrl = canonical ?? site + '/';
const ogType = type === 'article' ? 'article' : 'website';

// Rubriques de la navigation : catégories les plus fournies
const topCats = getCategories()
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count)
  .slice(0, 9);

const today = new Date().toLocaleDateString('fr-FR', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
});
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{decodeEntities(title)}</title>
    {description && <meta name="description" content={decodeEntities(description)} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {noindexAll && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={pageUrl} />
    {relPrev && <link rel="prev" href={relPrev} />}
    {relNext && <link rel="next" href={relNext} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Fluiid" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={decodeEntities(title)} />
    {description && <meta property="og:description" content={decodeEntities(description)} />}
    {ogImage && <meta property="og:image" content={ogImage} />}

    <link rel="sitemap" href={site + '/sitemap-index.xml'} />
    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body>
    <!-- Bandeau promo coulissant (sticky, tout en haut de chaque page) -->
    <div class="promo-ticker" aria-label="Offre spéciale — publications sponsorisées">
      <div class="promo-ticker-track">
        <a class="promo-ticker-item" href="/contact/">📢 Investissez dans une publication : le tremplin décisif pour le succès de votre entreprise</a>
        <span class="promo-ticker-sep" aria-hidden="true">✦</span>
        <a class="promo-ticker-item" href="/contact/">🔥 −40&nbsp;% sur tous les packs — offre de lancement</a>
        <span class="promo-ticker-sep" aria-hidden="true">✦</span>
        <a class="promo-ticker-item" href="/contact/">⏳ Offre limitée — publication sous 24&nbsp;h, liens SEO vers votre site</a>
        <span class="promo-ticker-sep" aria-hidden="true">✦</span>
        <a class="promo-ticker-item" href="/contact/">👉 Commander maintenant</a>
        <span class="promo-ticker-sep" aria-hidden="true">✦</span>
        <a class="promo-ticker-item" href="/contact/">📢 Investissez dans une publication : le tremplin décisif pour le succès de votre entreprise</a>
        <span class="promo-ticker-sep" aria-hidden="true">✦</span>
        <a class="promo-ticker-item" href="/contact/">🔥 −40&nbsp;% sur tous les packs — offre de lancement</a>
        <span class="promo-ticker-sep" aria-hidden="true">✦</span>
        <a class="promo-ticker-item" href="/contact/">⏳ Offre limitée — publication sous 24&nbsp;h, liens SEO vers votre site</a>
        <span class="promo-ticker-sep" aria-hidden="true">✦</span>
        <a class="promo-ticker-item" href="/contact/">👉 Commander maintenant</a>
        <span class="promo-ticker-sep" aria-hidden="true">✦</span>
      </div>
      <span class="ticker-countdown" role="timer" aria-label="Fin de l'offre dans">
        ⏳ <strong id="ticker-countdown">15:00</strong>
      </span>
    </div>
    <header class="site-header">
      <div class="header-top">
        <div class="container header-top-inner">
          <span class="header-date">{today}</span>
          <span class="header-tagline">L'actualité en Europe et dans le monde</span>
        </div>
      </div>
      <div class="header-brand">
        <div class="container header-brand-inner">
          <a class="logo" href="/">Fluiid</a>
        </div>
      </div>
    </header>
    <nav class="header-nav" id="nav-menu" aria-label="Rubriques">
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Ouvrir le menu">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
      <div class="container nav-inner">
        <a href="/">Accueil</a>
        <div class="nav-drop">
          <button class="nav-drop-btn" type="button" aria-expanded="false" aria-haspopup="true">
            Services <span class="nav-drop-caret" aria-hidden="true">▾</span>
          </button>
          <div class="nav-drop-menu" role="menu">
            {topCats.map((c) => (
              <a role="menuitem" href={`/#rubrique-${c.slug}`}>{decodeEntities(c.name)}</a>
            ))}
          </div>
        </div>
        <a href="/contact/">Contact</a>
      </div>
    </nav>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <span class="logo">Fluiid</span>
            <p>Le site de l'actualité en Europe et dans le monde. Analyse, décryptage et reportages.</p>
          </div>
          <div class="footer-col">
            <h3>Rubriques</h3>
            {topCats.map((c) => (
              <a href={`/#rubrique-${c.slug}`}>{decodeEntities(c.name)}</a>
            ))}
          </div>
          <div class="footer-col">
            <h3>Le site</h3>
            <a href="/">Accueil</a>
            <a href="/contact/">Contact</a>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} Fluiid — L'actualité en Europe et dans le monde</p>
        </div>
      </div>
    </footer>
    <script>
      // Menu burger mobile : ouverture/fermeture + accessibilité
      const navToggle = document.querySelector('.nav-toggle');
      const navMenu = document.getElementById('nav-menu');
      if (navToggle && navMenu) {
        const close = () => {
          navMenu.classList.remove('is-open');
          navToggle.setAttribute('aria-expanded', 'false');
        };
        navToggle.addEventListener('click', () => {
          const open = navMenu.classList.toggle('is-open');
          navToggle.setAttribute('aria-expanded', String(open));
        });
        navMenu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') close();
        });
      }
      // Menu déroulant « Services »
      const navDrop = document.querySelector('.nav-drop');
      const navDropBtn = document.querySelector('.nav-drop-btn');
      if (navDrop && navDropBtn) {
        const setDrop = (open) => {
          navDrop.classList.toggle('is-open', open);
          navDropBtn.setAttribute('aria-expanded', String(open));
        };
        navDropBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          setDrop(!navDrop.classList.contains('is-open'));
        });
        document.addEventListener('click', (e) => {
          if (!navDrop.contains(e.target)) setDrop(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setDrop(false);
        });
      }
      // Compte à rebours promo dans le bandeau (même minuteur que le formulaire)
      const tickerCd = document.getElementById('ticker-countdown');
      if (tickerCd) {
        const PKEY = 'fluiid_promo_v1';
        const PMS = 15 * 60 * 1000;
        let premain = PMS;
        try {
          const stored = parseInt(localStorage.getItem(PKEY), 10) || 0;
          const now = Date.now();
          if (!stored || now - stored >= PMS) { localStorage.setItem(PKEY, String(now)); premain = PMS; }
          else premain = PMS - (now - stored);
        } catch (e) { premain = PMS; }
        const pfmt = (ms) => `${String(Math.floor(ms / 60000)).padStart(2, '0')}:${String(Math.floor((ms % 60000) / 1000)).padStart(2, '0')}`;
        const ptick = () => {
          if (premain <= 0) { tickerCd.textContent = '00:00'; return; }
          tickerCd.textContent = pfmt(premain);
          premain -= 1000;
        };
        ptick();
        setInterval(ptick, 1000);
      }
    </script>
  </body>
</html>
