---
// Layout de base — head SEO complet (title, description, canonical, og, JSON-LD)
// Header magazine : bandeau date + marque + navigation rubriques sticky
import { decodeEntities, getCategories } from '../lib/wp.mjs';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: object[];
  type?: 'website' | 'article';
  relPrev?: string;
  relNext?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = false,
  jsonLd = [],
  type = 'website',
  relPrev,
  relNext,
} = Astro.props;

// Préversion : NOINDEX=1 au build => toutes les pages en noindex
const noindexAll = typeof process !== 'undefined' && process.env.NOINDEX === '1';

const site = String(Astro.site ?? 'https://fluiid.ch').replace(/\/$/, '');
const pageUrl = canonical ?? site + '/';
const ogType = type === 'article' ? 'article' : 'website';

// Rubriques de la navigation : catégories les plus fournies
const topCats = getCategories()
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count)
  .slice(0, 9);

const today = new Date().toLocaleDateString('fr-FR', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
});
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{decodeEntities(title)}</title>
    {description && <meta name="description" content={decodeEntities(description)} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {noindexAll && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={pageUrl} />
    {relPrev && <link rel="prev" href={relPrev} />}
    {relNext && <link rel="next" href={relNext} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Fluiid" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={decodeEntities(title)} />
    {description && <meta property="og:description" content={decodeEntities(description)} />}
    {ogImage && <meta property="og:image" content={ogImage} />}

    <link rel="sitemap" href={site + '/sitemap-index.xml'} />
    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="header-top">
        <div class="container header-top-inner">
          <span class="header-date">{today}</span>
          <span class="header-tagline">L'actualité en Europe et dans le monde</span>
        </div>
      </div>
      <div class="header-brand">
        <div class="container header-brand-inner">
          <a class="logo" href="/">Fluiid</a>
        </div>
      </div>
      <nav class="header-nav" aria-label="Rubriques">
        <div class="container nav-inner">
          <a href="/">Accueil</a>
          {topCats.map((c) => (
            <a href={`/#rubrique-${c.slug}`}>{decodeEntities(c.name)}</a>
          ))}
          <a href="/contact/">Contact</a>
        </div>
      </nav>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <span class="logo">Fluiid</span>
            <p>Le site de l'actualité en Europe et dans le monde. Analyse, décryptage et reportages.</p>
          </div>
          <div class="footer-col">
            <h3>Rubriques</h3>
            {topCats.map((c) => (
              <a href={`/#rubrique-${c.slug}`}>{decodeEntities(c.name)}</a>
            ))}
          </div>
          <div class="footer-col">
            <h3>Le site</h3>
            <a href="/">Accueil</a>
            <a href="/contact/">Contact</a>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} Fluiid — L'actualité en Europe et dans le monde</p>
        </div>
      </div>
    </footer>
  </body>
</html>
