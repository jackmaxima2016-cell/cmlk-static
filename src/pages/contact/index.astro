---
// Page Contact — commande de publications sponsorisées (modèle fluiid)
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';

const TITLE = 'Contact - Fluiid';
const DESC = "Commander une publication sponsorisée sur Fluiid : packs, durée, options, paiement sécurisé par carte bancaire.";
const CANONICAL = 'https://fluiid.ch/contact/';
---

<Base title={TITLE} description={DESC} canonical={CANONICAL}>
  <header class="entry-header">
    <h1 class="entry-title">Contact</h1>
  </header>

  <section class="contact-wrap">
    <div class="contact-intro">
      <p class="contact-kicker">Publications sponsorisées</p>
      <h2 class="contact-title">Commander maintenant</h2>
      <p>
        Quatre étapes, moins de deux minutes. Choisissez votre pack, la durée de
        publication et vos options : le total se calcule en direct. Nous revenons
        vers vous sous 24–48&nbsp;h pour valider le calendrier et l'angle
        éditorial. Paiement sécurisé par carte bancaire (Stripe).
      </p>
      <h3 class="roi-title">Pourquoi c'est rentable ?</h3>
      <ul class="roi-list">
        <li><strong>🔍 SEO — un backlink qui compte.</strong> Votre lien depuis un média d'actualité indexé et suivi (dofollow) renforce l'autorité de votre domaine et améliore votre classement Google.</li>
        <li><strong>🤖 GEO — visible par les IA.</strong> ChatGPT, Perplexity et Gemini citent les médias : votre contenu devient une source dans les réponses génératives.</li>
        <li><strong>♾️ Durable — pas un placement éphémère.</strong> Votre article reste en ligne et indexé pendant la durée choisie, jusqu'à vie.</li>
        <li><strong>💸 Un coût dérisoire.</strong> 169&nbsp;CHF = moins de 0,50&nbsp;CHF par jour sur un an, pour une visibilité permanente.</li>
      </ul>
      <ol class="contact-steps">
        <li><strong>1. Votre demande</strong> — pack + durée + options, ci-contre.</li>
        <li><strong>2. Confirmation sous 24–48&nbsp;h</strong> — validation du calendrier et de l'angle.</li>
        <li><strong>3. Publication</strong> — votre article paraît dans la rubrique choisie, avec vos liens.</li>
      </ol>
      <p class="contact-note">Tous les prix sont en CHF (ou EUR, au taux du jour) et s'entendent hors TVA.</p>
    </div>

    <div class="contact-form-wrap">
      <ContactForm />
    </div>
  </section>
</Base>

<style is:global>
  .contact-wrap { display: grid; grid-template-columns: 1fr; gap: 32px; max-width: var(--maxw); margin: 0 auto; }
  .contact-kicker { text-transform: uppercase; font-size: 12px; font-weight: 700; letter-spacing: .12em; color: var(--accent); margin: 0 0 8px; }
  .contact-title { font-size: 26px; margin: 0 0 14px; }
  .contact-intro p { font-size: 15px; line-height: 1.65; color: #222; }
  .roi-title { font-size: 15px; font-weight: 800; margin: 22px 0 10px; text-transform: uppercase; letter-spacing: .05em; }
  .roi-list { list-style: none; margin: 0; padding: 0; }
  .roi-list li { font-size: 13.5px; line-height: 1.6; padding: 10px 0; border-top: 1px solid #c8c8c8; color: #262626; }
  .roi-list li strong { display: block; margin-bottom: 2px; }
  .contact-steps { margin: 18px 0 0; padding-left: 18px; font-size: 14px; line-height: 1.7; color: #333; }
  .contact-note { font-size: 13px; color: #5c5c5c; margin-top: 16px; }
  @media (min-width: 900px) {
    .contact-wrap { grid-template-columns: 2fr 3fr; gap: 48px; }
  }
</style>
