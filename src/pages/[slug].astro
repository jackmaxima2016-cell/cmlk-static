---
// Article (post) ou page statique WordPress, servi à la racine : /{slug}/
import Base from '../layouts/Base.astro';
import { getPosts, getPages, getFeaturedImage, decodeEntities, stripHtml } from '../lib/wp.mjs';
import { getSeoForUrl } from '../lib/seo.mjs';

export async function getStaticPaths() {
  const posts = getPosts().map((post) => ({
    params: { slug: post.slug },
    props: { kind: 'post', entry: post },
  }));
  const pages = getPages().map((page) => ({
    params: { slug: page.slug },
    props: { kind: 'page', entry: page },
  }));
  return [...posts, ...pages];
}

const { kind, entry } = Astro.props;
const site = String(Astro.site ?? 'https://fluiid.ch').replace(/\/$/, '');
const canonical = `${site}/${entry.slug}/`;

// Titre et description réels (ce que Google voit) depuis l'audit WP,
// avec repli sur le titre du post + suffixe si l'audit n'est pas disponible.
const seo = getSeoForUrl(canonical);
const title = seo?.title ?? `${decodeEntities(entry.title?.rendered ?? '')} - Fluiid`;
const description = seo?.description
  ?? stripHtml(entry.excerpt?.rendered ?? entry.content?.rendered ?? '').slice(0, 160)
  ?? decodeEntities(entry.title?.rendered ?? '');
const image = getFeaturedImage(entry);
const author = decodeEntities(entry._embedded?.author?.[0]?.name ?? 'Fluiid');
const datePublished = entry.date;
const dateModified = entry.modified ?? entry.date;

const jsonLd = kind === 'post'
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: decodeEntities(entry.title?.rendered ?? ''),
        description,
        image,
        datePublished,
        dateModified,
        author: { '@type': 'Person', name: author },
        publisher: { '@type': 'Organization', name: 'Fluiid' },
        mainEntityOfPage: canonical,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Accueil', item: site + '/' },
          { '@type': 'ListItem', position: 2, name: decodeEntities(entry.title?.rendered ?? ''), item: canonical },
        ],
      },
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'Fluiid',
        url: site + '/',
        potentialAction: {
          '@type': 'SearchAction',
          target: { '@type': 'EntryPoint', urlTemplate: site + '/?s={search_term_string}' },
          'query-input': 'required name=search_term_string',
        },
      },
    ]
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: decodeEntities(entry.title?.rendered ?? ''),
        url: canonical,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Accueil', item: site + '/' },
          { '@type': 'ListItem', position: 2, name: decodeEntities(entry.title?.rendered ?? ''), item: canonical },
        ],
      },
    ];
---

<Base title={title} description={description} canonical={canonical} ogImage={image ?? undefined} jsonLd={jsonLd} type={kind === 'post' ? 'article' : 'website'}>
  <article class="entry">
    <header class="entry-header">
      <h1 class="entry-title" set:html={entry.title?.rendered ?? ''} />
      {kind === 'post' && (
        <div class="entry-meta">
          <time datetime={datePublished}>{new Date(datePublished).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
          <span class="entry-author">par {author}</span>
        </div>
      )}
    </header>
    {image && kind === 'post' && <img class="entry-img" src={image} alt={decodeEntities(entry.title?.rendered ?? '')} />}
    <div class="entry-content" set:html={entry.content?.rendered ?? ''} />
  </article>
</Base>
